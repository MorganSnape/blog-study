---
import "../styles/global.css";
const { title, headerTitle = "🌸 Blog de Gabriela", description = "Aprendiendo JavaScript con ternura" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <style lang="scss"></style>
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="text-gray-800 font-sans min-h-screen flex flex-col">
    <header class="bg-color-primario p-6 text-white shadow-md rounded-b-xl">
      <h1 class="text-3xl font-bold">{headerTitle}</h1>
      <p class="text-sm italic">{description}</p>
    </header>

    <main
      class="flex-1 max-w-3xl mx-auto p-6 mt-6 bg-white rounded-xl shadow-lg border border-color-primario"
    >
      <slot />
    </main>

    <footer class="p-4 mt-6 text-center text-sm text-white bg-color-secundario">
      ✨ Con cariño, Gabriela © 2026 ✨
    </footer>
  </body>
</html>
